rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.email == 'syahlanxzaelani@gmail.com' && request.auth.token.email_verified == true; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  match /users/{uid} {
   allow read: if true;
   allow create: if admin() || (owner(uid) && request.resource.data.role == 'user' && request.resource.data.id == uid && request.resource.data.keys().hasOnly(['id','email','name','role','created_at','photo']));
   allow update: if admin() || (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photo','fcmToken','fcmTokens','notifPermission','lastSeen']));
   allow delete: if admin();
  }
  match /kajian/{id} {
   allow read: if true;
   allow write: if admin();
   allow create: if signedIn() && request.resource.data.status == 'pending' && request.resource.data.submitted_by == request.auth.uid;
  }
  match /speakers/{id} { allow read: if true; allow write: if admin(); }
  match /mosques/{id} { allow read: if true; allow write: if admin(); }
  match /userData/{uid} { allow read, write: if owner(uid); }
  match /userData/{uid}/notes/{noteId} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['kajian_id','title','html','text','tags','mood','created_at','updated_at','pinned','snapshot']) && request.resource.data.html is string && request.resource.data.html.size() < 200000;
  }
 }
}
